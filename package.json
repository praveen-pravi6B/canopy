{
  "name": "canopy",
  "version": "0.0.1",
  "private": true,
  "description": "Local, black-box site tree and accessibility auditor.",
  "license": "MIT",
  "author": "Praveen Kumar",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "canopy": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "canopy": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "doctor": "tsx src/cli/index.ts doctor",
    "setup": "playwright install chromium"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^15.0.0",
    "node-html-parser": "^9.0.7",
    "picocolors": "^1.1.1",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
